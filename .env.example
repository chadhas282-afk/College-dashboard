# ── Supabase (required) ────────────────────────────────────────────────
# Project URL → Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-only, bypasses RLS). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Admin portal access ─────────────────────────────────────────────────
# The only email allowed into /admin (checked server-side in src/lib/auth.ts).
# The matching user must exist in Supabase → Authentication → Users.
ADMIN_EMAIL=admin@admin.com

# ── AI chat model ──────────────────────────────────────────────────────
# Primary: OpenAI (spec default is gpt-4o-mini)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# FREE fallback (used only when no OpenAI key is set): Google AI Studio →
# https://aistudio.google.com/apikey (no credit card; tool calling supported)
GOOGLE_GENERATIVE_AI_API_KEY=AIza...
# Alternatives: gemini-2.5-flash-lite, gemini-2.0-flash
GOOGLE_AI_MODEL=gemini-2.5-flash

# ── Google Calendar service account (optional until configured) ────────
# Follow "Google Calendar setup" in README.md to create these.
GOOGLE_SERVICE_ACCOUNT_EMAIL=calendar-bot@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
# When true, the app runs even without Google credentials (invites are skipped
# with a warning in the server log). Set to false once credentials are added.
GOOGLE_CALENDAR_ENABLED=false
